{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-proxy",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "VPS_TTS_URL": "http://204.168.146.194.sslip.io:8790/v1/audio/speech"
  },

  // Secrets — set via `wrangler secret put <NAME>` (never committed):
  //   ATLAS_PROXY_KEY   — bearer key every platform uses to call Atlas (same key as VPS proxy)
  //   DEEPSEEK_API_KEY  — DeepSeek V4 Pro (strategist) + paid chat
  //   ALIBABA_API_KEY   — Qwen chat + image generation
  //   GEMINI_API_KEY    — Gemini fallback chat
  //   AZURE_SPEECH_KEY / AZURE_SPEECH_REGION — neural TTS (optional)
}
